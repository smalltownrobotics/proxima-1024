# Copy this file to .env or export these variables in your shell.
# Never commit real credentials.
OPENAI_API_KEY=replace_with_your_openai_api_key
TYPESAFE_API_KEY=replace_with_your_typesafe_api_key
# VIGIL uses the locally authenticated Claude Code CLI by default.
PROXIMA_BRIEF_PROVIDER=claude
# Set PROXIMA_BRIEF_PROVIDER=astra to use the OpenAI technical-brief path.
